{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["node"],
    "paths": {
      "@aicode/plugin-sdk": ["./sdk/src/index.ts"]
    }
  },
  "include": [
    "sdk/src/**/*.ts",
    "samples/*/src/**/*.ts",
    "../plugin-official/*/src/**/*.ts"
  ]
}
