{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["node"],
    "paths": {
      "@aicode/plugin-sdk": ["./sdk/src/index.ts"],
      "@jieapi/plugin-sdk/page": ["./sdk/types/aicode.d.ts"],
      "@jieapi/plugin-sdk/page/vue": ["./sdk/types/aicode-vue.d.ts"]
    }
  },
  "include": [
    "sdk/src/**/*.ts",
    "sdk/types/**/*.d.ts",
    "samples/*/src/**/*.ts",
    "../plugin-official/*/src/**/*.ts",
    "template/types/**/*.d.ts"
  ]
}
