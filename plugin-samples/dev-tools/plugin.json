{
  "manifestVersion": 1,
  "id": "community.dev-tools",
  "name": {
    "default": "Dev Tools",
    "zh-CN": "开发工具"
  },
  "version": "1.1.0",
  "publisher": "community",
  "repository": "https://github.com/community/dev-tools",
  "description": {
    "default": "Build and clean the current Flutter or Android project.",
    "zh-CN": "为当前 Flutter / Android 项目提供构建与清理工具。"
  },
  "license": "MIT",
  "engines": {
    "pluginApi": "^1.0.0"
  },
  "permissions": [
    {
      "id": "workspace.tools",
      "required": true,
      "reason": "注册「构建 APK」与「清理缓存」两个项目工具",
      "scope": {
        "ids": ["build-apk", "clean-cache"]
      }
    },
    {
      "id": "workspace.exec",
      "required": true,
      "reason": "在工具页面中检测项目类型并执行构建、清理命令",
      "scope": {
        "ids": ["build-apk", "clean-cache"]
      }
    }
  ],
  "contributes": {
    "workspaceTools": [
      {
        "id": "build-apk",
        "title": {
          "default": "Build APK",
          "zh-CN": "构建 APK"
        },
        "description": {
          "default": "Detect the project type and build a debug or release package.",
          "zh-CN": "自动识别 Flutter 或 Android 项目，构建 Debug / Release 安装包。"
        },
        "icon": "hammer",
        "category": "构建",
        "pageFile": "pages/build-apk.html"
      },
      {
        "id": "clean-cache",
        "title": {
          "default": "Clean Cache",
          "zh-CN": "清理缓存"
        },
        "description": {
          "default": "Inspect build cache size and clean it with the project's own task.",
          "zh-CN": "查看构建缓存占用，并用项目自身的清理任务清空。"
        },
        "icon": "trash",
        "category": "构建",
        "pageFile": "pages/clean-cache.html"
      }
    ]
  }
}
