{
  "manifestVersion": 1,
  "id": "jieapi.desktop-pet",
  "name": {
    "default": "Desktop Pet",
    "zh-CN": "桌面宠物"
  },
  "version": "1.0.0",
  "publisher": "jieapi",
  "repository": "https://github.com/jieapi/AiCode",
  "description": {
    "default": "A draggable, interactive desktop pet that reacts to AI run status. Long press for the menu; size and display timing are configurable.",
    "zh-CN": "可拖拽、可点击互动的桌面宠物：跟随 AI 运行状态变化，长按打开菜单，可在配置页调整大小与显示时机。"
  },
  "license": "MIT",
  "icon": "icons/icon.png",
  "engines": {
    "pluginApi": "^1.0.0"
  },
  "runtime": {
    "type": "javascript",
    "entry": "dist/main.js",
    "resident": true
  },
  "contributes": {
    "overlay": {
      "purpose": "在桌面上显示一个可拖拽的宠物",
      "surfaces": [
        {
          "id": "pet",
          "page": "pages/pet.html",
          "width": 240,
          "height": 320,
          "draggable": true,
          "snap": "both"
        }
      ]
    },
    "hooks": [
      {
        "id": "boot",
        "event": "app.started",
        "handler": "hooks.boot"
      },
      {
        "id": "enabled",
        "event": "plugin.enabled",
        "handler": "hooks.pluginEnabled"
      },
      {
        "id": "run-started",
        "event": "agent.run.started",
        "handler": "hooks.agentRunStarted"
      },
      {
        "id": "tool-started",
        "event": "agent.tool.started",
        "handler": "hooks.agentToolStarted"
      },
      {
        "id": "tool-finished",
        "event": "agent.tool.finished",
        "handler": "hooks.agentToolFinished"
      },
      {
        "id": "run-finished",
        "event": "agent.run.finished",
        "handler": "hooks.agentRunFinished"
      }
    ],
    "configPage": "pages/config.html"
  }
}
